{
  "name": "skyfix-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SkyFix Lab browser workbench. Offline: no CDN fonts, scripts, styles or map tiles.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm": "CARGO_PROFILE_RELEASE_OPT_LEVEL=s wasm-pack build ../crates/skyfix-wasm --target web --out-dir ../../web/src/wasm-pkg --out-name skyfix_wasm --release"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "maplibre-gl": "^6.11.2"
  }
}
