{
  "name": "skyfix-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SkyFix Lab browser workbench. Offline: no CDN fonts, scripts, styles or map tiles.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm": "wasm-pack build ../crates/skyfix-wasm --target web --out-dir ../../web/src/wasm-pkg --out-name skyfix_wasm --release"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
